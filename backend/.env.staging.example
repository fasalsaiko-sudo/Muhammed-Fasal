# ============================================================================
# Muhammed Fasal Portfolio CMS — STAGING configuration template
#
# Copy to `.env.staging`, fill in real values, and never commit that file.
# Only this template is committed; every secret below is a placeholder.
#
# `ENVIRONMENT=staging` is hardened exactly like `production`: secure cookies,
# https, an explicit administrator allowlist, no stack traces, rate limiting and
# no interactive API docs are all enforced at startup. That is deliberate — a
# staging box that is hardened less than production validates nothing.
#
# NOTE ON VARIABLE NAMES
#   FRONTEND_ORIGIN  -> this app uses CORS_ALLOWED_ORIGINS (+ FRONTEND_URL).
#                       There is no FRONTEND_ORIGIN variable.
#   CSRF_SECRET      -> this app has no separate CSRF secret. The CSRF value is
#                       derived as HMAC(SESSION_SECRET, session_token_hash), so
#                       it is bound to the session and cannot be forged without
#                       SESSION_SECRET. Adding a second secret would create a
#                       second thing to rotate without adding security.
# ============================================================================

# --- Runtime ---------------------------------------------------------------
ENVIRONMENT=staging
LOG_LEVEL=INFO
# Public HTTPS base URL of the deployed backend. Must be https.
API_BASE_URL=https://staging-api.example.com

# --- Database --------------------------------------------------------------
# A real managed PostgreSQL instance. Placeholder passwords are refused at
# startup when ENVIRONMENT is staging or production.
DATABASE_URL=postgresql+psycopg://STAGING_USER:STAGING_PASSWORD@STAGING_HOST:5432/portfolio_cms
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
# Leave on "auto" for a real PostgreSQL server. ("static" exists only for the
# single-connection PGlite test harness.)
DATABASE_POOL_CLASS=auto
SECURE_ERRORS=true

# --- GitHub OAuth ----------------------------------------------------------
# Register a SEPARATE OAuth App for staging; do not reuse the production one.
#   Homepage URL:                https://staging.example.com
#   Authorization callback URL:  https://staging-api.example.com/auth/github/callback
# The callback must match GITHUB_REDIRECT_URI character for character, and must
# be served by API_BASE_URL - both are checked at startup.
GITHUB_CLIENT_ID=STAGING_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=STAGING_GITHUB_CLIENT_SECRET
GITHUB_REDIRECT_URI=https://staging-api.example.com/auth/github/callback
ALLOWED_GITHUB_USERNAME=Fasal17

# --- Session ---------------------------------------------------------------
# Generate a distinct secret per environment:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SESSION_SECRET=STAGING_SESSION_SECRET_AT_LEAST_32_CHARS
SESSION_COOKIE_NAME=mf_cms_session
CSRF_COOKIE_NAME=mf_cms_csrf
SESSION_TTL_MINUTES=480
SESSION_IDLE_TTL_MINUTES=120
# Staging is internet-facing, so Secure is mandatory and enforced at startup.
COOKIE_SECURE=true
# "lax" when the admin and API share a registrable domain.
# "none" when the admin is cross-site from the API (e.g. a github.io admin
# calling a different API domain); it requires COOKIE_SECURE=true.
SESSION_COOKIE_SAMESITE=lax
CSRF_HEADER_NAME=X-CSRF-Token
MAX_SESSIONS_PER_USER=5
OAUTH_STATE_TTL_SECONDS=600

# --- Origins ---------------------------------------------------------------
# The deployed staging frontend origin, and any admin origin. All must be https
# and all must be listed explicitly; "*" is refused.
FRONTEND_URL=https://staging.example.com
ADMIN_URL=https://staging.example.com/admin
CORS_ALLOWED_ORIGINS=https://staging.example.com

# --- Google Drive (leave unset unless staging media is being exercised) ----
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_DRIVE_FOLDER_TEMPLATE=Portfolio CMS Staging
DRIVE_PUBLIC_READ=true

# --- Upload limits ---------------------------------------------------------
MAX_UPLOAD_IMAGE_BYTES=10485760
MAX_UPLOAD_PDF_BYTES=20971520
MAX_UPLOAD_VIDEO_BYTES=524288000
MAX_UPLOAD_DOCUMENT_BYTES=20971520

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=30
RATE_LIMIT_PUBLIC_PER_MINUTE=120

# --- Caching ---------------------------------------------------------------
PUBLIC_CACHE_TTL_SECONDS=60

# --- Reverse proxy ---------------------------------------------------------
# true only when behind a proxy you control, so the recorded session IP and the
# rate limiter see the real client address.
TRUST_PROXY_HEADERS=true

# --- Public static snapshot ------------------------------------------------
PUBLIC_SNAPSHOT_PATH=data/portfolio.json
ENABLE_SNAPSHOT_WRITE=false

# --- Docs ------------------------------------------------------------------
# Staging serves no interactive API docs unless both are true.
DOCS_ENABLED=false
DOCS_ENABLED_IN_PRODUCTION=false
