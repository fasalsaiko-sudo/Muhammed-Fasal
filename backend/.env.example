# ============================================================================
# Muhammed Fasal Portfolio CMS — backend configuration
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# Only this template is committed; it contains placeholders, no credentials.
#
# PRODUCTION CHECKLIST — the app refuses to boot unless ALL of these hold.
# Each one fails at startup naming the variable to fix, so a misconfiguration
# cannot become a deployment that silently cannot authenticate anyone.
#
#   ENVIRONMENT=production
#   SESSION_SECRET                  >= 32 chars, required (never generated for you)
#   COOKIE_SECURE=true              required
#   SECURE_ERRORS=true              required (no stack traces in responses)
#   RATE_LIMIT_ENABLED=true         required
#   DATABASE_URL                    real password - "change-me" is rejected
#   API_BASE_URL                    https:// only
#   GITHUB_CLIENT_ID / _SECRET      both required
#   GITHUB_REDIRECT_URI             https:// AND must start with API_BASE_URL
#   ALLOWED_GITHUB_USERNAME         required - there is no default administrator
#   CORS_ALLOWED_ORIGINS            https:// origins only, and non-empty
#   FRONTEND_URL / ADMIN_URL        https:// - see the CORS note below
#
# Local development keeps working with none of the above: an ephemeral session
# secret is generated, cookies stay non-Secure over http, and GitHub sign-in is
# simply reported as unavailable rather than breaking the public site.
# ============================================================================

# --- Runtime ---------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
# Base URL of this API, e.g. http://localhost:8000 or https://api.muhammedfasal.com
API_BASE_URL=http://localhost:8000

# --- Database (PostgreSQL) -------------------------------------------------
DATABASE_URL=postgresql+psycopg://portfolio_cms:change-me@localhost:5432/portfolio_cms
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
# auto   -> no pooling while testing, QueuePool in production (default)
# static -> reuse one connection for the whole process. REQUIRED for the PGlite
#           test harness, which serves a single connection at a time and closes
#           connections arriving during rapid reconnect churn.
# queue  -> force the production pool even while testing.
# Production should leave this on "auto".
DATABASE_POOL_CLASS=auto
# When true, unhandled exceptions return a generic 500 without a stack trace.
# Must be true in production.
SECURE_ERRORS=true

# --- GitHub OAuth ----------------------------------------------------------
# Create the OAuth App at https://github.com/settings/developers
# (OAuth Apps -> New OAuth App). Homepage URL: the public site. Authorization
# callback URL: EXACTLY the value of GITHUB_REDIRECT_URI below - a mismatch is
# the usual cause of GitHub's "redirect_uri_mismatch" error.
GITHUB_CLIENT_ID=
# Client secret: generated by GitHub, shown once. Store it in the platform
# secret manager, never in the repository.
GITHUB_CLIENT_SECRET=
# Must match the callback URL registered in the GitHub OAuth App settings.
# Local:      http://localhost:8000/auth/github/callback
# Production: https://<api-host>/auth/github/callback  (https enforced, and it
#             must be served by API_BASE_URL)
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback
# Comma separated allowlist. Only these GitHub accounts receive an admin session.
# Required in production - there is deliberately no default administrator, so a
# stale value cannot survive a deploy and keep access.
ALLOWED_GITHUB_USERNAME=Fasal17
GITHUB_API_URL=https://api.github.com
GITHUB_AUTHORIZE_URL=https://github.com/login/oauth/authorize
GITHUB_TOKEN_URL=https://github.com/login/oauth/access_token

# --- Session ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Required in production (>= 32 chars). In development an ephemeral one is
# generated, which means sessions do not survive a restart - correct for dev.
SESSION_SECRET=
SESSION_COOKIE_NAME=mf_cms_session
CSRF_COOKIE_NAME=mf_cms_csrf
# A session is valid for min(absolute, idle). Activity refreshes the idle window
# only; the absolute deadline is never extended. Idle may not exceed absolute.
SESSION_TTL_MINUTES=480
SESSION_IDLE_TTL_MINUTES=120
# Set to true only when serving over HTTPS (production, where it is enforced).
# Over plain HTTP the browser will not send the cookie back at all.
COOKIE_SECURE=false
# WHEN EACH VALUE IS REQUIRED:
#   lax   -> the admin and the API are on the SAME SITE (same registrable
#            domain). This is the current dev setup: both on localhost:8000.
#            Also correct for muhammedfasal.com + api.muhammedfasal.com, which
#            share the eTLD+1 and are therefore same-site.
#   none  -> REQUIRED when the admin is CROSS-SITE from the API, i.e. on a
#            different registrable domain. Example: an admin served from
#            https://fasalsaiko-sudo.github.io calling https://api.example.com.
#            With lax the browser omits the cookie on fetch(credentials:include),
#            so every admin call would fail with 401.
#            Browsers reject SameSite=None without Secure, so this app refuses to
#            start with none + COOKIE_SECURE=false rather than logging you out.
#   strict-> most restrictive, but it also blocks the post-GitHub redirect that
#            completes the login, so do not use it for this flow.
SESSION_COOKIE_SAMESITE=lax
CSRF_HEADER_NAME=X-CSRF-Token
# Oldest sessions beyond this cap are revoked on the next login. 0 disables it.
MAX_SESSIONS_PER_USER=5

# --- OAuth state -----------------------------------------------------------
# Lifetime of a single-use login state. The state is stored server-side, hashed,
# and consumed before the GitHub code is exchanged, so it cannot be replayed.
OAUTH_STATE_TTL_SECONDS=600

# --- Frontend / admin URLs (used for CORS + OAuth redirect) ----------------
# FRONTEND_URL and ADMIN_URL are ALSO added to the CORS allowlist, so in
# production they must be real https URLs. Leaving the localhost defaults in
# place is rejected at startup: it would otherwise let any page on a visitor's
# own machine make credentialed cross-origin requests to the admin API.
FRONTEND_URL=http://localhost:8080
ADMIN_URL=http://localhost:8000/admin
# Comma separated allowlist of origins allowed to call the API from a browser.
# Rules enforced at startup:
#   * "*" is refused outright - the API allows credentialed requests, so a
#     wildcard with credentials is never acceptable.
#   * every entry must be an absolute http(s) origin (scheme + host only; a
#     browser Origin header never carries a path or trailing slash).
#   * paths are normalised away, so https://host/Repo/ becomes https://host.
#   * in production every origin must be https.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:8080

# --- Google Drive storage --------------------------------------------------
# Storage boundary for the CMS. The backend creates/manages child folders here.
GOOGLE_DRIVE_ROOT_FOLDER_ID=1gGcnYdfjX5PCWJP-gwwUwIFflHZlVqIW
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Newlines in the key must be encoded as \n when supplied through the environment.
GOOGLE_PRIVATE_KEY=
# Alternative: path to a service account JSON file (not recommended in containers).
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_DRIVE_FOLDER_TEMPLATE=Portfolio CMS
DRIVE_PUBLIC_READ=true

# --- Upload limits (bytes) -------------------------------------------------
MAX_UPLOAD_IMAGE_BYTES=10485760
MAX_UPLOAD_PDF_BYTES=20971520
MAX_UPLOAD_VIDEO_BYTES=524288000
MAX_UPLOAD_DOCUMENT_BYTES=20971520

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=30
RATE_LIMIT_PUBLIC_PER_MINUTE=120

# --- Caching ---------------------------------------------------------------
PUBLIC_CACHE_TTL_SECONDS=60

# --- Reverse proxy ----------------------------------------------------------
# Set true ONLY when the app runs behind a proxy you control (Render, Fly,
# nginx, Cloudflare). It makes rate limiting trust X-Forwarded-For for the
# client IP. Enabling it while directly exposed lets any client spoof that
# header and evade rate limits.
TRUST_PROXY_HEADERS=false

# --- Public static snapshot ------------------------------------------------
# When set, publishing content regenerates this JSON file (relative to repo root).
PUBLIC_SNAPSHOT_PATH=data/portfolio.json
ENABLE_SNAPSHOT_WRITE=false

# --- Docs ------------------------------------------------------------------
# /docs, /redoc and /openapi.json. Master switch for development.
DOCS_ENABLED=true
# Separate opt-in required for production: DOCS_ENABLED defaults to true for
# development convenience, and interactive docs publish the whole admin API
# surface to anonymous callers. Production serves them only when BOTH are true.
DOCS_ENABLED_IN_PRODUCTION=false
