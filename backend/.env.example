# ============================================================================
# Muhammed Fasal Portfolio CMS — backend configuration
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# ============================================================================

# --- Runtime ---------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
# Base URL of this API, e.g. http://localhost:8000 or https://api.muhammedfasal.com
API_BASE_URL=http://localhost:8000

# --- Database (PostgreSQL) -------------------------------------------------
DATABASE_URL=postgresql+psycopg://portfolio_cms:change-me@localhost:5432/portfolio_cms
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
# When true, unhandled exceptions return a generic 500 without a stack trace.
# Must be true in production.
SECURE_ERRORS=true

# --- GitHub OAuth ----------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must match the callback URL registered in the GitHub OAuth App settings.
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback
# Comma separated allowlist. Only these GitHub accounts receive an admin session.
ALLOWED_GITHUB_USERNAME=Fasal17
GITHUB_API_URL=https://api.github.com
GITHUB_AUTHORIZE_URL=https://github.com/login/oauth/authorize
GITHUB_TOKEN_URL=https://github.com/login/oauth/access_token

# --- Session ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SESSION_SECRET=
SESSION_COOKIE_NAME=mf_cms_session
CSRF_COOKIE_NAME=mf_cms_csrf
SESSION_TTL_MINUTES=480
SESSION_IDLE_TTL_MINUTES=120
# Set to true only when serving over HTTPS (production).
COOKIE_SECURE=false
# lax  -> admin and API share a site (current dev: both on localhost:8000)
# none -> required when the admin is cross-site from the API (e.g. a GitHub Pages
#         origin calling a different API host). Browsers reject SameSite=None
#         without Secure, so the app refuses to boot with none + COOKIE_SECURE=false.
# strict-> most restrictive; breaks the post-GitHub redirect flow, so avoid it here.
SESSION_COOKIE_SAMESITE=lax
CSRF_HEADER_NAME=X-CSRF-Token
# Oldest sessions beyond this cap are revoked on the next login. 0 disables it.
MAX_SESSIONS_PER_USER=5

# --- OAuth state -----------------------------------------------------------
# Lifetime of a single-use login state. The state is stored server-side, hashed,
# and consumed before the GitHub code is exchanged, so it cannot be replayed.
OAUTH_STATE_TTL_SECONDS=600

# --- Frontend / admin URLs (used for CORS + OAuth redirect) ----------------
FRONTEND_URL=http://localhost:8080
ADMIN_URL=http://localhost:8000/admin
# Comma separated allowlist of origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:8080

# --- Google Drive storage --------------------------------------------------
# Storage boundary for the CMS. The backend creates/manages child folders here.
GOOGLE_DRIVE_ROOT_FOLDER_ID=1gGcnYdfjX5PCWJP-gwwUwIFflHZlVqIW
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Newlines in the key must be encoded as \n when supplied through the environment.
GOOGLE_PRIVATE_KEY=
# Alternative: path to a service account JSON file (not recommended in containers).
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_DRIVE_FOLDER_TEMPLATE=Portfolio CMS
DRIVE_PUBLIC_READ=true

# --- Upload limits (bytes) -------------------------------------------------
MAX_UPLOAD_IMAGE_BYTES=10485760
MAX_UPLOAD_PDF_BYTES=20971520
MAX_UPLOAD_VIDEO_BYTES=524288000
MAX_UPLOAD_DOCUMENT_BYTES=20971520

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=30
RATE_LIMIT_PUBLIC_PER_MINUTE=120

# --- Caching ---------------------------------------------------------------
PUBLIC_CACHE_TTL_SECONDS=60

# --- Reverse proxy ----------------------------------------------------------
# Set true ONLY when the app runs behind a proxy you control (Render, Fly,
# nginx, Cloudflare). It makes rate limiting trust X-Forwarded-For for the
# client IP. Enabling it while directly exposed lets any client spoof that
# header and evade rate limits.
TRUST_PROXY_HEADERS=false

# --- Public static snapshot ------------------------------------------------
# When set, publishing content regenerates this JSON file (relative to repo root).
PUBLIC_SNAPSHOT_PATH=data/portfolio.json
ENABLE_SNAPSHOT_WRITE=false

# --- Docs ------------------------------------------------------------------
# FastAPI /docs and /redoc are disabled automatically when ENVIRONMENT=production
# unless this is true.
DOCS_ENABLED=true
